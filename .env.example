# Supabase (wajib)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — HANYA server (Vercel), jangan expose ke browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Host utama produksi — tanpa http/https (wajib di Vercel production)
# Contoh: melemporr.com
NEXT_PUBLIC_BASE_HOST=localhost:3000

# Prefix subdomain enterprise (opsional, default: grabs-id-)
# OG Grab tidak bergantung prefix ini — ditentukan template_id slug di database.
# NEXT_PUBLIC_ENTERPRISE_SUBDOMAIN_PREFIX=grabs-id-
